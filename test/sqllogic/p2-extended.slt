query rowsort
SELECT u.id AS uid, o.amount AS amt FROM users_p2 u INNER JOIN orders_p2 o ON u.id = o.user_id WHERE o.amount >= 20 ORDER BY u.id, o.id
----
1|60
2|20
4|25
----

query rowsort
SELECT id FROM orders_p2 WHERE EXISTS (SELECT 1 FROM users_p2 WHERE id = outer.user_id AND tier >= 2) ORDER BY id
----
10
13
14
----

query rowsort
SELECT user_id, SUM(amount) FROM orders_p2 GROUP BY user_id ORDER BY user_id
----
1|70
2|20
4|25
9|30
