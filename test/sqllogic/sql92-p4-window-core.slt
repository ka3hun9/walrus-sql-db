# SQL-92 phase-4 bootstrap: minimal executable window subset

statement ok
CREATE TABLE p4_boot_scores (id INT PRIMARY KEY, grp TEXT, score INT)
----

statement ok
INSERT INTO p4_boot_scores (id, grp, score) VALUES (1, 'A', 10)
----

statement ok
INSERT INTO p4_boot_scores (id, grp, score) VALUES (2, 'A', 20)
----

statement ok
INSERT INTO p4_boot_scores (id, grp, score) VALUES (3, 'A', 20)
----

statement ok
INSERT INTO p4_boot_scores (id, grp, score) VALUES (4, 'B', 5)
----

statement ok
INSERT INTO p4_boot_scores (id, grp, score) VALUES (5, 'B', 15)
----

query rowsort
SELECT grp, id, score, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY score DESC, id ASC) AS rn FROM p4_boot_scores ORDER BY grp, rn
----
A|2|20|1
A|3|20|2
A|1|10|3
B|5|15|1
B|4|5|2
----

query nosort
SELECT id, ROW_NUMBER() OVER (ORDER BY score DESC, id ASC) AS rn FROM p4_boot_scores ORDER BY rn
----
2|1
3|2
5|3
1|4
4|5
----
