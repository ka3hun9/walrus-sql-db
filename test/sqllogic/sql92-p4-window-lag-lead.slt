# SQL-92 Phase 4: Window function LAG/LEAD offset access

statement ok
CREATE TABLE stock (day INT, price INT)
----

statement ok
INSERT INTO stock (day, price) VALUES (1, 100)
----

statement ok
INSERT INTO stock (day, price) VALUES (2, 105)
----

statement ok
INSERT INTO stock (day, price) VALUES (3, 102)
----

statement ok
INSERT INTO stock (day, price) VALUES (4, 110)
----

# LAG access previous day
query rowsort
SELECT day, price,
       LAG(price) OVER (ORDER BY day) AS prev_price
FROM stock ORDER BY day
----
1|100|NULL
2|105|100
3|102|105
4|110|102
----

# LEAD access next day
query rowsort
SELECT day, price,
       LEAD(price) OVER (ORDER BY day) AS next_price
FROM stock ORDER BY day
----
1|100|105
2|105|102
3|102|110
4|110|NULL
----
