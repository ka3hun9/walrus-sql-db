# SQL-92 phase-4 bootstrap: CTE boundary captured as expected-error baseline

statement ok
CREATE TABLE p4_boot_cte_users (id INT PRIMARY KEY, grp TEXT)
----

statement ok
INSERT INTO p4_boot_cte_users (id, grp) VALUES (1, 'A')
----

statement ok
