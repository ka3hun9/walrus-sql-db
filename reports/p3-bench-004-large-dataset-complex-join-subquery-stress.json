    "subquerySql": "SELECT customer_id FROM p3_bench4_customers WHERE customer_tier <= 4 AND customer_id <= 80 AND customer_id IN (SELECT customer_id FROM p3_bench4_orders WHERE order_status = 'paid') AND EXISTS (SELECT 1 FROM p3_bench4_customers WHERE p3_bench4_customers.customer_region = outer.customer_region AND customer_tier >= 4) AND customer_id < (SELECT MAX(customer_id) FROM p3_bench4_customers WHERE p3_bench4_customers.customer_region = outer.customer_region) ORDER BY customer_id ASC LIMIT 150",
