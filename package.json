{
  "name": "walrus-sql-db",
  "version": "0.3.0",
  "description": "Pure on-chain oriented Walrus SQL SDK starter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{ recursive:true, force:true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx examples/crud.ts",
    "onchain:plan": "tsx examples/onchain-plan.ts",
    "onchain:exec": "tsx examples/onchain-exec.ts",
    "onchain:select": "tsx examples/select.ts",
    "onchain:select-replay": "tsx examples/select-replay.ts",
    "onchain:benchmark-replay": "tsx examples/benchmark-replay.ts",
    "sql:advanced": "tsx examples/sql-advanced.ts",
    "sql:join": "tsx examples/sql-join.ts",
    "onchain:join-replay": "tsx examples/onchain-join-replay.ts",
    "sql:roadmap": "tsx examples/sql-roadmap.ts",
    "sql:compare": "tsx examples/sql-compare-baseline.ts",
    "sql:compare:sqlite": "tsx examples/sql-compare-sqlite.ts",
    "sql:compare:matrix": "tsx examples/sql-compare-matrix.ts",
    "sql:budget:gate": "tsx examples/sql-budget-gate.ts",
    "sql:constraint:cost:bench": "tsx examples/sql-constraint-cost-benchmark.ts reports/sql-constraint-cost.json pr",
    "sql:constraint:cost:gate": "tsx examples/sql-constraint-cost-gate.ts reports/sql-constraint-cost.json pr",
    "sql:fuzz": "tsx examples/sql-fuzz.ts",
    "sql:compare:matrix:category": "tsx examples/sql-compare-matrix.ts reports/sql-compare-category.json reports/mre pr",
    "sql:compare:matrix:g5": "tsx examples/sql-compare-matrix.ts reports/sql-compare-g5-fixture.json reports/mre pr g5-fixture",
    "sql:compare:matrix:g5:nightly": "tsx examples/sql-compare-matrix.ts reports/sql-compare-g5-fixture-nightly.json reports/mre nightly g5-fixture",
    "sql:compare:matrix:nightly": "tsx examples/sql-compare-matrix.ts reports/sql-compare-nightly.json reports/mre nightly",
    "sql:perf:bench": "tsx examples/sql-performance-benchmark.ts reports/sql-performance-benchmark.json",
    "sql:ast:smoke": "tsx examples/sql-ast-smoke.ts",
    "sql:typedvalue:migration": "tsx examples/sql-typedvalue-migration.ts",
    "sql:semantic:grouped": "tsx examples/sql-semantic-grouped-runner.ts",
    "sql:logic": "tsx examples/sql-logic-runner.ts test/sqllogic/p1-basic.slt",
    "sql:logic:p2": "tsx examples/sql-logic-runner.ts test/sqllogic/p2-extended.slt",
    "sql:logic:all": "tsx test/unit-h-test-005-sqllogic-extension.ts",
    "p2:bench:tpcc": "tsx examples/p2-bench-tpcc-mini.ts",
    "p2:bench:conflict": "tsx examples/p2-bench-conflict.ts",
    "p2:bench:longrun": "tsx examples/p2-bench-longrun.ts",
    "p3:bench:001": "tsx examples/p3-bench-001-no-index-complex-baseline.ts",
    "p3:bench:002": "tsx examples/p3-bench-002-indexed-same-load-benefit.ts",
    "test:ci:unit": "tsx scripts/run-ci-tests.ts unit",
    "test:ci:integration": "tsx scripts/run-ci-tests.ts integration",
    "test:ci:regression": "tsx scripts/run-ci-tests.ts regression",
    "test:ci:typedvalue": "tsx scripts/run-typedvalue-tests.ts",
    "test:ci:benchmark": "tsx test/unit-h-test-006-performance-benchmark-gate.ts",
    "test:ci": "npm run test:ci:unit && npm run test:ci:integration && npm run test:ci:regression",
    "ci:full": "npm run build && npm run test:ci && npm run test:ci:typedvalue && npm run test:ci:benchmark",
    "sql:verify:full": "npm run build && npm run sql:compare:matrix && npm run sql:compare:matrix:nightly && npm run sql:roadmap",
    "onchain:smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "start": "node dist/examples/crud.js"
  },
  "keywords": [
    "sui",
    "walrus",
    "sql",
    "sdk",
    "blockchain"
  ],
  "author": "ka3hun9",
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@mysten/sui": "^1.37.6",
    "cbor-x": "^1.6.4",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
