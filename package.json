{
  "name": "walrus-sql-db",
  "version": "0.3.0",
  "description": "Pure on-chain oriented Walrus SQL SDK starter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{ recursive:true, force:true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "sui",
    "walrus",
    "sql",
    "sdk",
    "blockchain"
  ],
  "author": "ka3hun9",
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@mysten/sui": "^1.37.6",
    "cbor-x": "^1.6.4",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.4"
  }
}
